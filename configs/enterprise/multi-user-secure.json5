// ============================================================
// 🏢 企业场景：多用户 + 安全加固
// ============================================================
// 适合团队部署：多人共用一个 OpenClaw 实例，
// 通过配对模式控制访问，按渠道/用户路由到不同 agent。
//
// 安全特性：
//   - 严格的 DM 配对制度
//   - 群聊白名单
//   - 日志审计
//   - 敏感信息脱敏
//   - 会话自动清理
// ============================================================
{
  // 身份配置
  identity: {
    name: "企业助手",
    theme: "专业的企业 AI 助理",
    emoji: "🏢",
  },

  // 日志：开启审计级别 + 敏感信息脱敏
  logging: {
    level: "info",
    file: "/var/log/openclaw/openclaw.log",
    consoleLevel: "info",
    // 工具输出脱敏（不记录完整的工具执行结果）
    redactSensitive: "tools",
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: {
        primary: "moonshot/kimi-k2.5",
        fallbacks: ["minimax/MiniMax-M2.1"],
      },
    },

    // 多 agent 配置：不同用户路由到不同 agent
    list: [
      { id: "main" },
      {
        id: "dev-team",
        workspace: "/opt/openclaw/workspaces/dev-team",
      },
      {
        id: "ops-team",
        workspace: "/opt/openclaw/workspaces/ops-team",
      },
    ],
  },

  // 路由绑定：按用户/群聊分配 agent
  bindings: [
    {
      agentId: "dev-team",
      match: {
        channel: "feishu",
        peer: { kind: "group", id: "oc_开发群ID" },
      },
    },
    {
      agentId: "ops-team",
      match: {
        channel: "feishu",
        peer: { kind: "group", id: "oc_运维群ID" },
      },
    },
  ],

  channels: {
    feishu: {
      enabled: true,
      // 严格配对：所有用户必须通过审批
      dmPolicy: "pairing",
      // 群聊白名单
      groupPolicy: "allowlist",
      groupAllowFrom: ["ou_管理员ID"],
      streaming: true,
      accounts: {
        main: {
          appId: "cli_你的AppID",
          appSecret: "你的AppSecret",
          botName: "企业助手",
        },
      },
    },
  },

  // 会话管理：安全策略
  session: {
    scope: "per-sender",
    reset: {
      mode: "daily",
      atHour: 4,
      idleMinutes: 60,
    },
    // 会话存储维护
    maintenance: {
      mode: "warn",
      pruneAfter: "7d",
      maxEntries: 200,
      rotateBytes: "5mb",
      resetArchiveRetention: "30d",
    },
  },
}
