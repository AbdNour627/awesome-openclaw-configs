// ============================================================
// DeepSeek 模型配置（通过 OpenRouter 访问）
// ============================================================
// OpenClaw 没有内置 DeepSeek 作为独立 provider，
// 推荐通过 OpenRouter 统一网关访问 DeepSeek 系列模型。
// OpenRouter 支持 DeepSeek R1、V3 等全系列模型。
//
// 前置条件：
//   1. 注册 OpenRouter 账号：https://openrouter.ai
//   2. 获取 API Key（格式：sk-or-...）
//   3. 设置环境变量或写入配置
//
// 使用方法：
//   将本文件内容合并到 ~/.openclaw/openclaw.json
// ============================================================
{
  // 环境变量：API Key
  env: {
    OPENROUTER_API_KEY: "sk-or-你的密钥",
  },

  // 模型配置
  agents: {
    defaults: {
      // 主模型：DeepSeek R1（推理模型，适合复杂任务）
      model: {
        primary: "openrouter/deepseek/deepseek-r1",
        // 备用模型：DeepSeek V3（更快、更便宜）
        fallbacks: ["openrouter/deepseek/deepseek-chat"],
      },
      // 模型别名（方便用 /model 命令切换）
      models: {
        "openrouter/deepseek/deepseek-r1": { alias: "R1" },
        "openrouter/deepseek/deepseek-chat": { alias: "V3" },
      },
    },
  },
}
