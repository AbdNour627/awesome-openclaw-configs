// ============================================================
// Moonshot / Kimi 模型配置
// ============================================================
// Moonshot 提供 Kimi 系列模型，OpenAI 兼容接口。
// 支持 Kimi K2.5、K2 Thinking 等模型。
//
// 前置条件：
//   1. 注册 Moonshot 开放平台：https://platform.moonshot.cn
//   2. 获取 API Key（格式：sk-...）
//   3. 快速配置：openclaw onboard --auth-choice moonshot-api-key
//
// 注意：
//   - 国际端点：https://api.moonshot.ai/v1
//   - 中国端点：https://api.moonshot.cn/v1（国内网络推荐）
//   - Moonshot 和 Kimi Coding 是两个独立的 provider，密钥不互通
// ============================================================
{
  env: {
    MOONSHOT_API_KEY: "sk-你的密钥",
  },

  agents: {
    defaults: {
      // 主模型：Kimi K2.5（最新旗舰）
      model: { primary: "moonshot/kimi-k2.5" },
      models: {
        "moonshot/kimi-k2.5": { alias: "K2.5" },
        "moonshot/kimi-k2-thinking": { alias: "K2思考" },
        "moonshot/kimi-k2-thinking-turbo": { alias: "K2思考快速" },
        "moonshot/kimi-k2-turbo-preview": { alias: "K2快速" },
      },
    },
  },

  // 自定义 provider 配置（可选，如需覆盖默认值）
  models: {
    mode: "merge",
    providers: {
      moonshot: {
        // 国内用户推荐使用 .cn 端点
        baseUrl: "https://api.moonshot.cn/v1",
        apiKey: "${MOONSHOT_API_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "kimi-k2.5",
            name: "Kimi K2.5",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 8192,
          },
          {
            id: "kimi-k2-thinking",
            name: "Kimi K2 Thinking",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 8192,
          },
          {
            id: "kimi-k2-thinking-turbo",
            name: "Kimi K2 Thinking Turbo",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 256000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
}
