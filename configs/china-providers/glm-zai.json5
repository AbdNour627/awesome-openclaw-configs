// ============================================================
// 智谱 GLM 模型配置（通过 Z.AI 平台）
// ============================================================
// GLM 是智谱 AI 的模型系列，在 OpenClaw 中通过 zai provider 访问。
// 支持 GLM-5、GLM-4.7、GLM-4.6 等版本。
//
// 前置条件：
//   1. 注册 Z.AI 平台并获取 API Key
//   2. 快速配置：openclaw onboard --auth-choice zai-api-key
//   3. 或非交互式：openclaw onboard --zai-api-key "$ZAI_API_KEY"
//
// 特性：
//   - 默认启用 tool_stream（工具调用流式传输）
//   - 使用 Bearer 认证
// ============================================================
{
  env: {
    ZAI_API_KEY: "sk-你的密钥",
  },

  agents: {
    defaults: {
      // 主模型：GLM-5（最新旗舰）
      model: { primary: "zai/glm-5" },
      models: {
        "zai/glm-5": { alias: "GLM5" },
      },
    },
  },
}
