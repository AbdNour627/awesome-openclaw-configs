// ============================================================
// 🚀 推荐入门配置
// ============================================================
// 适合大多数中国用户的入门配置。
// 使用国产模型 Kimi K2.5 + WhatsApp。
//
// 使用前：
//   1. 安装 OpenClaw：npm i -g openclaw
//   2. 运行向导：openclaw onboard
//   3. 配置 Kimi：openclaw onboard --auth-choice moonshot-api-key
//   4. 连接 WhatsApp：openclaw channels login --channel whatsapp
//   5. 启动：openclaw gateway
// ============================================================
{
  // 给你的 AI 取个名字
  identity: {
    name: "小助手",
    theme: "全能 AI 私人助理",
    emoji: "🤖",
  },

  env: {
    MOONSHOT_API_KEY: "sk-你的密钥",
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: { primary: "moonshot/kimi-k2.5" },
      models: {
        "moonshot/kimi-k2.5": { alias: "Kimi" },
      },

      // 心跳：每小时检查一次
      heartbeat: {
        every: "1h",
        target: "last",
        activeHours: {
          start: "08:00",
          end: "23:00",
        },
      },
    },
  },

  channels: {
    whatsapp: {
      dmPolicy: "pairing",
      allowFrom: ["+86你的手机号"],
      groups: { "*": { requireMention: true } },
    },
  },

  // 消息队列
  routing: {
    queue: {
      mode: "collect",
      debounceMs: 1000,
    },
  },

  // 会话管理
  session: {
    scope: "per-sender",
    reset: {
      mode: "daily",
      atHour: 4,
    },
    resetTriggers: ["/new", "/reset"],
  },
}
