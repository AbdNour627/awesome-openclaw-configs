// ============================================================
// ⚡ 一次性提醒任务
// ============================================================
// 让 AI 在指定时间提醒你某件事。
// 任务执行后自动删除。
//
// 创建命令示例：
//   openclaw cron add \
//     --name "开会提醒" \
//     --at "2026-03-02T14:00:00+08:00" \
//     --session main \
//     --system-event "提醒：15分钟后有产品评审会" \
//     --wake now \
//     --delete-after-run
//
// 说明：
//   --at          一次性时间点（ISO 8601 格式）
//   --session     main = 在主会话中执行
//   --wake now    立即唤醒 agent（不等下次心跳）
//   --delete-after-run  执行后自动删除任务
//
// 管理：
//   openclaw cron list    # 查看待执行任务
//   openclaw cron delete <job-id>  # 取消任务
// ============================================================

// 这是一个说明文件。一次性提醒通过 CLI 命令创建。
// 以下是基础配置，确保 Gateway 正常运行。
{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: { primary: "moonshot/kimi-k2.5" },
    },
  },
}
