// ============================================================
// ⚡ 心跳 + 主动式助手配置
// ============================================================
// 让 AI 助手定期自主检查邮件、日历、天气等，
// 有重要事项时主动通知你，没事就安静。
//
// 心跳（Heartbeat）是 Gateway 的定时轮询机制：
//   每隔一段时间触发一次 agent turn，
//   agent 决定是否有事汇报。
//
// 配合 HEARTBEAT.md 使用效果最佳：
//   在 workspace 中创建 HEARTBEAT.md，写上检查清单。
// ============================================================
{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: { primary: "moonshot/kimi-k2.5" },

      heartbeat: {
        // 每 30 分钟检查一次
        every: "30m",

        // 心跳消息发送目标
        // "last" = 发到最后一个聊天窗口
        // "none" = 不发送（静默执行）
        target: "last",

        // 活跃时间窗口（避免深夜打扰）
        activeHours: {
          start: "08:00",
          end: "23:00",
        },

        // 自定义心跳提示词（可选）
        // prompt: "检查邮件、日历和天气，有重要事项就告诉我。",

        // HEARTBEAT_OK 后允许的最大字符数
        ackMaxChars: 300,
      },
    },
  },
}
